{
  "name": "dsh-session-switcher",
  "version": "1.3.0",
  "description": "DSH Desktop plugin: hold Ctrl and tap Tab to switch between recently viewed sessions, release Ctrl to open the highlighted one. · DSH Desktop 插件：按住 Ctrl 敲 Tab 在最近会话间切换，松开 Ctrl 打开高亮会话。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "verify-client.cjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh-desktop",
    "session-switcher",
    "ctrl-tab",
    "productivity"
  ],
  "author": "Yporcupine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yporcupine/dsh-session-switcher.git"
  },
  "homepage": "https://github.com/Yporcupine/dsh-session-switcher#readme",
  "bugs": {
    "url": "https://github.com/Yporcupine/dsh-session-switcher/issues"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node verify-client.cjs",
    "verify": "node verify-client.cjs",
    "prepublishOnly": "node verify-client.cjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  }
}
